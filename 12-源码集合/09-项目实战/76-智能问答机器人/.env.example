# =============================================================================
#  .env.example — 智能问答机器人环境变量模板
#  作者: 测试员周周 (14年测试老兵)
#  描述: 环境变量可用于覆盖 config.yaml 中的配置项
#  优先级: 环境变量 > config.yaml > 默认值
#  用法: 复制为 .env 文件，按需修改
# =============================================================================

# 知识库路径
QA_BOT_KNOWLEDGE_BASE_PATH=data/knowledge

# 检索参数
QA_BOT_RETRIEVAL_TOP_K=5
QA_BOT_RETRIEVAL_THRESHOLD=0.15

# 生成参数
QA_BOT_GENERATION_MAX_LENGTH=200

# 质量评估参数
QA_BOT_QUALITY_PASS_THRESHOLD=0.7

# LLM API 配置（生产环境使用）
# LLM_API_KEY=sk-xxxxx
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo
