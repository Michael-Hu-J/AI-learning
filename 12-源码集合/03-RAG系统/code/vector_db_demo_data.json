  "metadata": [
    {
      "id": "doc_001",
      "title": "doc_001",
      "text": "RAG检索增强生成结合检索和生成，通过知识库检索增强大模型能力。"
    },
    {
      "id": "doc_002",
      "title": "doc_002",
      "text": "向量数据库存储高维向量，支持高效相似度搜索，是RAG核心组件。"
    },
    {
      "id": "doc_003",
      "title": "doc_003",
      "text": "Embedding将文本转为向量，语义相似的文本向量距离更近。"
    },
    {
      "id": "doc_004",
      "title": "doc_004",
      "text": "大语言模型如GPT、Claude、Qwen具有强大文本理解和生成能力。"
    },
    {
      "id": "doc_005",
      "title": "doc_005",
      "text": "知识图谱结构化存储实体关系，可与RAG结合提供更精确检索。"
    },
    {
      "id": "doc_006",
      "title": "doc_006",
      "text": "语义搜索基于文本语义含义而非关键词匹配，通过向量相似度实现。"
    }
  ],
